{
  "name": "@selectwin/mcp",
  "version": "0.1.0",
  "description": "Selectwin MCP server — documentation + API tools over the Model Context Protocol.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=18" },
  "bin": { "selectwin-mcp": "./dist/stdio.js" },
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "files": ["dist", "src", "openapi.json", "README.md"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start:http": "node dist/http.js",
    "start:stdio": "node dist/stdio.js",
    "sync:spec": "node scripts/sync-spec.mjs",
    "inspect": "npx @modelcontextprotocol/inspector"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.3.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  },
  "repository": { "type": "git", "url": "https://github.com/selectwin/mcp.git" },
  "homepage": "https://docs.selectwin.io",
  "keywords": ["selectwin", "mcp", "model-context-protocol", "payments", "api", "docs"]
}
